# Copy this file to ".env" and fill in your local PostgreSQL details

PORT=5000

# ---- PostgreSQL (your local DB) ----
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cinevault_auth

# ---- JWT ----
JWT_SECRET=cinevault_super_secret_key_change_this
JWT_EXPIRES_IN=7d

# ---- Frontend URL (for CORS) ----
CLIENT_URL=http://localhost:5173
